#!/usr/bin/env python3

import asyncio
import json
import os
import signal
import sys

from dbus_next import Variant
from dbus_next.aio import MessageBus
from dbus_next.service import ServiceInterface, method


BUS_NAME = "org.freedesktop.impl.portal.desktop.kfile"
OBJECT_PATH = "/org/freedesktop/portal/desktop"
INTERFACE = "org.freedesktop.impl.portal.FileChooser"
REQUEST_INTERFACE = "org.freedesktop.impl.portal.Request"

HELPER = "/usr/local/bin/kfile-helper"

# Maximum time a helper process may remain open.
HELPER_TIMEOUT = 600


# ============================================================
# Logging
# ============================================================

def log(message):
    print(
        f"[xdg-desktop-portal-kfile] {message}",
        file=sys.stderr,
        flush=True,
    )


def log_helper(pid, message):
    log(f"[kfile-helper:{pid}] {message}")


# ============================================================
# D-Bus helpers
# ============================================================

def get_option(options, name, default=None):
    """
    Get a value from a D-Bus a{sv} dictionary.

    dbus-next returns Variant objects for values from a{sv}.
    """
    value = options.get(name)

    if value is None:
        return default

    if isinstance(value, Variant):
        return value.value

    return value


# ============================================================
# Portal byte-array helpers
# ============================================================

def decode_path_bytes(value):
    """
    Decode a portal byte-array path using the local filesystem
    encoding.

    Portal byte arrays may contain trailing NUL bytes.
    """
    if value is None:
        return ""

    if isinstance(value, str):
        return value.rstrip("\x00")

    if isinstance(value, (bytes, bytearray)):
        raw = bytes(value)

        while raw.endswith(b"\x00"):
            raw = raw[:-1]

        return os.fsdecode(raw)

    return str(value).rstrip("\x00")


def decode_filename_list(value):
    """
    Decode SaveFiles' aay filename list.
    """
    if not value:
        return []

    result = []

    for item in value:
        filename = decode_path_bytes(item)

        if filename:
            result.append(filename)

    return result


# ============================================================
# File URI handling
# ============================================================

def normalize_file_uri(uri):
    """
    Accept only local file:// URIs.

    Remote URLs are intentionally rejected because this backend
    is restricted to local KDE/KIO file selection.
    """
    if not isinstance(uri, str):
        return None

    if not uri.startswith("file:"):
        return None

    # file:///path
    # file://localhost/path
    if uri.startswith("file://localhost/"):
        uri = "file://" + uri[len("file://localhost"):]

    if not uri.startswith("file:///"):
        return None

    return uri


def normalize_uris(uris):
    result = []

    for uri in uris:
        normalized = normalize_file_uri(uri)

        if normalized is not None:
            result.append(normalized)

    return result


# ============================================================
# Portal filter conversion
# ============================================================

def convert_filters(filters):
    """
    Convert portal filters:

        a(sa(us))

    into the JSON format expected by kfile-helper.
    """
    if not filters:
        return []

    result = []

    for filter_data in filters:
        try:
            name = str(filter_data[0])
            entries = filter_data[1]
        except (IndexError, TypeError):
            continue

        globs = []
        mimes = []

        for entry in entries:
            try:
                filter_type = int(entry[0])
                value = str(entry[1])
            except (IndexError, TypeError):
                continue

            if filter_type == 0:
                globs.append(value)

            elif filter_type == 1:
                mimes.append(value)

        result.append(
            {
                "name": name,
                "globs": globs,
                "mimes": mimes,
            }
        )

    return result


def convert_current_filter(current_filter):
    """
    Convert portal current_filter:

        (sa(us))

    into the filter name used by kfile-helper.
    """
    if not current_filter:
        return ""

    try:
        return str(current_filter[0])
    except (IndexError, TypeError):
        return ""


# ============================================================
# Request construction
# ============================================================

def build_request(
    operation,
    options,
    title="",
    accept_label="",
    multiple=False,
    current_name="",
    files=None,
):
    """
    Build a JSON request for kfile-helper.
    """
    current_folder_raw = get_option(
        options,
        "current_folder",
        None,
    )

    filters_raw = get_option(
        options,
        "filters",
        [],
    )

    current_filter_raw = get_option(
        options,
        "current_filter",
        None,
    )

    current_folder = decode_path_bytes(
        current_folder_raw
    )

    filters = convert_filters(
        filters_raw
    )

    current_filter = convert_current_filter(
        current_filter_raw
    )

    request = {
        "operation": operation,
        "multiple": bool(multiple),
        "directory": current_folder,
        "filters": filters,
        "current_filter": current_filter,
        "current_name": str(current_name or ""),
        "title": str(title or ""),
        "accept_label": str(accept_label or ""),
    }

    if files is not None:
        request["files"] = list(files)

    return request


# ============================================================
# Helper process management
# ============================================================

async def kill_process(process, reason=""):
    """
    Safely terminate a helper process.

    ProcessLookupError is expected if the process exits between
    checking returncode and sending the signal.
    """
    if process is None:
        return

    try:
        if process.returncode is None:
            if reason:
                log_helper(
                    process.pid,
                    f"Terminating helper: {reason}",
                )

            process.kill()

    except ProcessLookupError:
        log_helper(
            process.pid,
            "Helper already exited",
        )

    except OSError as exc:
        log_helper(
            process.pid,
            f"Failed to terminate helper: {exc}",
        )


async def read_helper_stderr(process):
    """
    Read helper stderr and prefix every diagnostic line with PID.

    Keeping stderr in a pipe avoids mixing diagnostics from several
    helper processes directly at the terminal/journal level.
    """
    if process.stderr is None:
        return

    try:
        while True:
            line = await process.stderr.readline()

            if not line:
                break

            text = line.decode(
                "utf-8",
                errors="replace",
            ).rstrip()

            if text:
                log_helper(
                    process.pid,
                    text,
                )

    except asyncio.CancelledError:
        raise

    except Exception as exc:
        log_helper(
            process.pid,
            f"stderr reader failed: {exc}",
        )


async def run_helper(request, request_object=None):
    """
    Execute kfile-helper and parse its JSON response.

    Helper diagnostics are read from stderr and prefixed with the
    helper PID.

    The helper is allowed to remain open for up to HELPER_TIMEOUT
    seconds.

    If request_object is provided, the helper process is registered
    with the corresponding portal request so Request.Close can
    terminate it directly.
    """
    payload = (
        json.dumps(
            request,
            ensure_ascii=False,
        )
        + "\n"
    )

    log(
        "Starting kfile-helper: "
        + json.dumps(
            request,
            ensure_ascii=False,
        )
    )

    try:
        process = await asyncio.create_subprocess_exec(
            HELPER,
            stdin=asyncio.subprocess.PIPE,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )

    except OSError as exc:
        log(
            "Failed to start kfile-helper: "
            + str(exc)
        )
        return None

    # Register the helper immediately after it starts.
    # This allows Request.Close to terminate the actual helper
    # process while the dialog is open.
    if request_object is not None:
        request_object.set_process(process)

    stderr_task = asyncio.create_task(
        read_helper_stderr(process)
    )

    stdout = b""

    try:
        # Send the request to the helper.
        if process.stdin is not None:
            process.stdin.write(
                payload.encode("utf-8")
            )

            await process.stdin.drain()
            process.stdin.close()

        # Read stdout directly.
        #
        # Do NOT use process.communicate() here because stderr is
        # already being read by read_helper_stderr(). communicate()
        # would create a second concurrent reader for stderr.
        if process.stdout is not None:
            stdout = await asyncio.wait_for(
                process.stdout.read(),
                timeout=HELPER_TIMEOUT,
            )

        # Wait until the helper exits.
        await asyncio.wait_for(
            process.wait(),
            timeout=HELPER_TIMEOUT,
        )

    except asyncio.TimeoutError:
        await kill_process(
            process,
            f"timeout after {HELPER_TIMEOUT} seconds",
        )

        try:
            await process.wait()
        except Exception:
            pass

        log(
            "kfile-helper timed out after "
            f"{HELPER_TIMEOUT} seconds"
        )

        return None

    except asyncio.CancelledError:
        await kill_process(
            process,
            "request cancelled",
        )

        try:
            await process.wait()
        except Exception:
            pass

        raise

    except Exception as exc:
        await kill_process(
            process,
            f"helper I/O failed: {exc}",
        )

        try:
            await process.wait()
        except Exception:
            pass

        log(
            "kfile-helper I/O failed: "
            + str(exc)
        )

        return None

    finally:
        # stderr has its own dedicated reader.
        # Wait for it to finish after the helper exits.
        try:
            await stderr_task
        except asyncio.CancelledError:
            pass
        except Exception:
            pass

        if request_object is not None:
            request_object.set_process(None)

    if process.returncode != 0:
        log(
            "kfile-helper exited with code "
            + str(process.returncode)
        )

    stdout_text = stdout.decode(
        "utf-8",
        errors="replace",
    ).strip()

    if not stdout_text:
        log(
            "kfile-helper returned no stdout"
        )
        return None

    # kfile-helper normally writes one JSON object.
    # Search backwards so accidental diagnostic lines cannot
    # break parsing.
    lines = stdout_text.splitlines()

    response_line = None

    for line in reversed(lines):
        line = line.strip()

        if not line:
            continue

        if line.startswith("{") and line.endswith("}"):
            response_line = line
            break

    if response_line is None:
        log(
            "Could not find JSON response from kfile-helper"
        )

        log(
            "Helper stdout: "
            + repr(stdout_text)
        )

        return None

    try:
        return json.loads(response_line)

    except json.JSONDecodeError as exc:
        log(
            "Invalid JSON from kfile-helper: "
            + str(exc)
        )

        log(
            "Helper stdout: "
            + repr(stdout_text)
        )

        return None


# ============================================================
# Portal response construction
# ============================================================

def make_success_response(response):
    """
    Build a successful portal response.
    """
    uris = normalize_uris(
        response.get(
            "uris",
            [],
        )
    )

    result = {
        "uris": Variant(
            "as",
            uris,
        ),
    }

    current_filter = response.get(
        "current_filter"
    )

    if current_filter:
        name = str(
            current_filter.get(
                "name",
                "",
            )
        )

        entries = []

        for glob in current_filter.get(
            "globs",
            [],
        ):
            entries.append(
                [
                    0,
                    str(glob),
                ]
            )

        for mime in current_filter.get(
            "mimes",
            [],
        ):
            entries.append(
                [
                    1,
                    str(mime),
                ]
            )

        result["current_filter"] = Variant(
            "(sa(us))",
            [
                name,
                entries,
            ],
        )

    return result


# ============================================================
# Request object
# ============================================================

class PortalRequest(ServiceInterface):
    def __init__(self, path):
        super().__init__(
            REQUEST_INTERFACE
        )

        self.path = path
        self.process = None
        self.task = None

    def set_process(self, process):
        self.process = process

    def set_task(self, task):
        self.task = task

    @method(name="Close")
    async def close(self):
        log(
            f"Request.Close received for {self.path}"
        )

        await kill_process(
            self.process,
            "Request.Close",
        )

        if self.task is not None and not self.task.done():
            self.task.cancel()


# ============================================================
# FileChooser D-Bus interface
# ============================================================

class FileChooser(ServiceInterface):
    def __init__(self, bus):
        super().__init__(
            INTERFACE
        )

        self.bus = bus
        self.requests = {}

        log(
            "FileChooser interface initialized"
        )

    # --------------------------------------------------------
    # Request handling
    # --------------------------------------------------------

    async def run_dialog(
        self,
        handle,
        request,
    ):
        request_object = PortalRequest(
            handle
        )

        self.requests[handle] = request_object

        self.bus.export(
            handle,
            request_object,
        )

        current_task = asyncio.current_task()

        request_object.set_task(
            current_task
        )

        try:
            response = await run_helper(
                request,
                request_object,
            )

        except asyncio.CancelledError:
            log(
                f"Portal request cancelled: {handle}"
            )

            raise

        finally:
            self.bus.unexport(
                handle
            )

            self.requests.pop(
                handle,
                None,
            )

        if response is None:
            log(
                f"Helper failed for request: {handle}"
            )

            return [
                2,
                {},
            ]

        if not response.get(
            "accepted",
            False,
        ):
            log(
                f"Dialog cancelled: {handle}"
            )

            return [
                1,
                {},
            ]

        return [
            0,
            make_success_response(
                response
            ),
        ]

    # --------------------------------------------------------
    # OpenFile
    # --------------------------------------------------------

    @method(name="OpenFile")
    async def open_file(
        self,
        handle: "o",
        app_id: "s",
        parent_window: "s",
        title: "s",
        options: "a{sv}",
    ) -> "ua{sv}":

        del parent_window

        log(
            "OpenFile requested by "
            + repr(app_id)
        )

        multiple = bool(
            get_option(
                options,
                "multiple",
                False,
            )
        )

        directory = bool(
            get_option(
                options,
                "directory",
                False,
            )
        )

        accept_label = get_option(
            options,
            "accept_label",
            "",
        )

        if directory:
            operation = "directory"
        else:
            operation = "open"

        request = build_request(
            operation=operation,
            options=options,
            title=title,
            accept_label=accept_label,
            multiple=multiple,
        )

        return await self.run_dialog(
            handle,
            request,
        )

    # --------------------------------------------------------
    # SaveFile
    # --------------------------------------------------------

    @method(name="SaveFile")
    async def save_file(
        self,
        handle: "o",
        app_id: "s",
        parent_window: "s",
        title: "s",
        options: "a{sv}",
    ) -> "ua{sv}":

        del parent_window

        log(
            "SaveFile requested by "
            + repr(app_id)
        )

        current_name = get_option(
            options,
            "current_name",
            "",
        )

        accept_label = get_option(
            options,
            "accept_label",
            "",
        )

        request = build_request(
            operation="save",
            options=options,
            title=title,
            accept_label=accept_label,
            current_name=current_name,
        )

        return await self.run_dialog(
            handle,
            request,
        )

    # --------------------------------------------------------
    # SaveFiles
    # --------------------------------------------------------

    @method(name="SaveFiles")
    async def save_files(
        self,
        handle: "o",
        app_id: "s",
        parent_window: "s",
        title: "s",
        options: "a{sv}",
    ) -> "ua{sv}":

        del parent_window

        log(
            "SaveFiles requested by "
            + repr(app_id)
        )

        files_raw = get_option(
            options,
            "files",
            [],
        )

        files = decode_filename_list(
            files_raw
        )

        if not files:
            log(
                "SaveFiles request contains no files"
            )

            return [
                2,
                {},
            ]

        accept_label = get_option(
            options,
            "accept_label",
            "",
        )

        request = build_request(
            operation="save_files",
            options=options,
            title=title,
            accept_label=accept_label,
            files=files,
        )

        return await self.run_dialog(
            handle,
            request,
        )


# ============================================================
# Main
# ============================================================

async def main():
    log("Starting")

    bus = await MessageBus().connect()

    interface = FileChooser(
        bus
    )

    bus.export(
        OBJECT_PATH,
        interface,
    )

    await bus.request_name(
        BUS_NAME
    )

    log(
        "D-Bus name acquired: "
        + BUS_NAME
    )

    log("Ready")

    await bus.wait_for_disconnect()


if __name__ == "__main__":
    try:
        asyncio.run(
            main()
        )

    except KeyboardInterrupt:
        pass

    except Exception as exc:
        log(
            "Fatal error: "
            + repr(exc)
        )

        raise
